# Copier en .env et remplir. Ne jamais committer le vrai fichier .env.
APP_ENV=development
SUPABASE_URL=https://<projet>.supabase.co
# Clé JWT « legacy » (HS256). Laisser vide pour utiliser les clés asymétriques (JWKS).
SUPABASE_JWT_SECRET=
# Clé publique du projet (Project Settings > API Keys > Publishable key) : envoi du code de connexion
SUPABASE_PUBLISHABLE_KEY=
# false = accepte les sessions ouvertes avec le mot de passe seul (développement uniquement)
REQUIRE_EMAIL_CODE=true
# Connexion directe PostgreSQL (rôle postgres, via le pooler Supabase en mode session)
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5000,https://app.example.com
DEFAULT_COUNTRY=TG

# Moteur de tirage dans le backend : seulement si pg_cron n'est pas actif sur Supabase
DRAW_ENGINE_ENABLED=false

# Requêtes par minute et par adresse IP
RATE_LIMIT_PER_MINUTE=120
# Nombre de proxys devant l'API (Render, Fly, Nginx… = 1). 0 si l'API est exposée directement.
TRUSTED_PROXY_HOPS=0
