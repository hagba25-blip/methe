# Copier en .env et remplir. Ne jamais committer le vrai fichier .env.
APP_ENV=development
SUPABASE_URL=https://<projet>.supabase.co
# Clé JWT « legacy » (HS256). Laisser vide pour utiliser les clés asymétriques (JWKS).
SUPABASE_JWT_SECRET=
# Connexion directe PostgreSQL (rôle postgres, via le pooler Supabase en mode session)
DATABASE_URL=postgresql://postgres.<projet>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres
CORS_ORIGINS=http://localhost:5000,https://app.example.com
DEFAULT_COUNTRY=TG
